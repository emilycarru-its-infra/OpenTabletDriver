#!/bin/bash

# OpenTabletDriver postinstall script
# Runs after the package is installed

APP_PATH="/Applications/OpenTabletDriver.app"
DAEMON_PATH="${APP_PATH}/Contents/MacOS/OpenTabletDriver.Daemon"

# Verify installation
if [[ ! -d "${APP_PATH}" ]]; then
    echo "Error: OpenTabletDriver.app not found at ${APP_PATH}"
    exit 1
fi

# Verify the bundle ID is correct
BUNDLE_ID=$(defaults read "${APP_PATH}/Contents/Info.plist" CFBundleIdentifier 2>/dev/null || echo "")
if [[ "${BUNDLE_ID}" != "ca.ecuad.macadmin.OpenTabletDriver" ]]; then
    echo "Warning: Bundle ID mismatch. Expected ca.ecuad.macadmin.OpenTabletDriver, got ${BUNDLE_ID}"
fi

# Set proper permissions
echo "Setting permissions..."
chown -R root:wheel "${APP_PATH}"
chmod -R 755 "${APP_PATH}"

# Make executables executable
find "${APP_PATH}/Contents/MacOS" -type f -exec chmod +x {} \; 2>/dev/null || true

echo "OpenTabletDriver installed successfully"
echo ""
echo "IMPORTANT: Privacy Permissions Required"
echo "=========================================="
echo "OpenTabletDriver requires the following permissions:"
echo "  • Accessibility - To move the cursor"
echo "  • Input Monitoring - To read cursor position (relative mode)"
echo ""
echo "Deploy the OpenTabletDriver.mobileconfig profile to grant these permissions."
echo ""
echo "Manual grant (not recommended):"
echo "  System Settings → Privacy & Security → Accessibility"
echo "  System Settings → Privacy & Security → Input Monitoring"
echo ""

exit 0
